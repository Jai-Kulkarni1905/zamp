# Copy to .env and fill in. .env is git-ignored.

# Gemini (only used when LLM_MODE=live or when recording fixtures)
GEMINI_API_KEY=
GEMINI_MODEL=

# fixture: read recorded extractions from data/fixtures (default, no API calls)
# live:    call Gemini on a cache miss and save the result as a fixture
LLM_MODE=fixture

# Defaults to SQLite at data/ap.db. Postgres example: postgresql+psycopg://user:pass@host/db
DATABASE_URL=

# Optional: pin "today" (YYYY-MM-DD) for date rules. Empty means today's date in IST.
AS_OF_DATE=
