# Copy to .env and fill in. .env is git-ignored.

# Gemini (only used when LLM_MODE=live or when recording fixtures)
GEMINI_API_KEY=
GEMINI_MODEL=

# fixture: read recorded extractions from data/fixtures (default, no API calls)
# live:    call Gemini on a cache miss and save the result as a fixture
LLM_MODE=fixture

# Defaults to SQLite at data/ap.db. Postgres example: postgresql+psycopg://user:pass@host/db
DATABASE_URL=

# Optional: pin "today" (YYYY-MM-DD) for date rules. Empty means today's date in IST.
AS_OF_DATE=

# API (Layer 3)
# Pause after each stage so the live view visibly streams in fixture mode. 0 = no pause.
STAGE_DELAY_MS=0
# If set, POST /api/admin/reset requires header X-Admin-Token with this value.
ADMIN_TOKEN=
# Comma-separated origins allowed to call the API from a browser (Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
